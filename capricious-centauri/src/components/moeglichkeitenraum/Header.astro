---
// Header.astro — Hero-Banner + Anker-Navigation
---

<header class="site-header">
    <!-- ── Hero-Bild-Bereich ──────────────────────────── -->
    <div
        class="hero"
        role="img"
        aria-label="Gruppe im Kreis, Möglichkeitenraum Berlin"
    >
        <!-- Hintergrundbild: Ken-Burns-Bewegung + leichte Unschärfe -->
        <div class="hero-bg" aria-hidden="true"></div>

        <!-- Dunkles Gradient-Overlay für Textlesbarkeit -->
        <div class="hero-overlay" aria-hidden="true"></div>

        <!-- Wutraum-Button oben rechts -->
        <a href="/wut" class="wut-link" aria-label="Zum Wut-Intro">
            Hier geht es zum Wut-Intro ➔
        </a>

        <!-- Zitat -->
        <div class="hero-content">
            <p class="hero-kicker">Möglichkeitenraum Berlin</p>
            <h1 class="hero-title">
                Gemeinsam betreten wir das,<br />
                was allein unzugänglich bleibt.
            </h1>
        </div>
    </div>

    <!-- ── Anker-Navigation (sticky nach dem Hero) ────── -->
    <nav class="site-nav" aria-label="Seitennavigation">
        <a href="#kontext">Möglichkeit</a>
        <a href="#teilnahme">Dabei sein</a>
        <a href="#wer-wir-sind">Wer wir sind</a>
        <a href="#kontakt">Kontakt</a>
    </nav>
</header>

<style>
    /* ── Wrapper ──────────────────────────────────────────────────────────── */

    .site-header {
        display: flex;
        flex-direction: column;
    }

    /* ── Hero ─────────────────────────────────────────────────────────────── */

    .hero {
        position: relative;
        width: 100%;
        height: 100svh; /* bildschirmfüllend, iOS-Safari-safe */
        min-height: 520px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /*
   * Hintergrundbild auf einem eigenen Layer.
   * inset: -5% gibt Spielraum für die Zoom-Animation,
   * damit am Rand kein weißer Streifen entsteht.
   */
    .hero-bg {
        position: absolute;
        inset: -5%;
        background-image: url("/images/hero_moeglichkeitenraum.png");
        background-size: cover;
        background-position: center top; /* oben verankern, Logo unten abschneiden */
        animation: kenBurns 24s ease-in-out infinite alternate;
        will-change: transform, filter;
    }

    @keyframes kenBurns {
        0% {
            transform: scale(1) translate(0%, 0%);
            filter: blur(0px);
        }
        100% {
            transform: scale(1.09) translate(-1.2%, -0.6%);
            filter: blur(2px);
        }
    }

    /*
   * Gradient-Overlay: mischt Pine-Grün-Tönung (links oben, Raumhalter)
   * mit tiefem Ink-Dunkel (unten, Lesbarkeit des Zitats).
   */
    .hero-overlay {
        position: absolute;
        inset: 0;
        background:
      /* Unten schwarz abblenden → Logo zuverlässig versteckt */
            linear-gradient(
                to bottom,
                rgba(38, 29, 18, 0) 60%,
                rgba(38, 29, 18, 0.96) 92%,
                rgba(38, 29, 18, 1) 100%
            ),
            /* Atmosphärisches Haupt-Overlay – Warmbraun-Tönung */
            linear-gradient(
                    155deg,
                    rgba(61, 42, 24, 0.22) 0%,
                    rgba(38, 29, 18, 0.48) 55%,
                    rgba(38, 29, 18, 0.65) 100%
                );
    }

    /* ── Wutraum-Link (oben rechts, über dem Overlay) ────────────────────── */

    .wut-link {
        position: absolute;
        top: 2rem;
        right: 2rem;
        z-index: 20;
        padding: 0.6rem 1.25rem;
        background-color: rgba(196, 77, 42, 0.88);
        color: #faf6ee;
        font-family: var(--font-body);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-decoration: none;
        border-radius: 3px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        border: 1px solid rgba(250, 246, 238, 0.18);
        transition:
            background-color 0.22s ease,
            transform 0.18s ease;
    }

    .wut-link:hover {
        background-color: var(--color-terra);
        color: #faf6ee;
        transform: translateY(-1px);
    }

    @media (max-width: 640px) {
        .wut-link {
            top: 1rem;
            right: 1rem;
            font-size: 0.72rem;
            padding: 0.5rem 0.9rem;
        }
    }

    /* ── Zitat ────────────────────────────────────────────────────────────── */

    .hero-content {
        position: relative;
        z-index: 10;
        text-align: center;
        padding: 2rem;
        max-width: 860px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
    }

    .hero-kicker {
        font-family: var(--font-body);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(250, 246, 238, 0.65);
        margin: 0;
        max-width: none;
    }

    .hero-title {
        font-family: var(--font-heading);
        font-size: clamp(1.75rem, 4.2vw, 3.1rem);
        font-weight: 700;
        line-height: 1.32;
        color: #faf6ee;
        text-shadow:
            0 2px 8px rgba(38, 29, 18, 0.45),
            0 8px 32px rgba(38, 29, 18, 0.3);
        margin: 0;
    }

    /* ── Anker-Navigation ─────────────────────────────────────────────────── */

    .site-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        justify-content: center;
        background-color: var(--color-pine);
        /* dünner Schatten markiert die Nav, wenn Content darunter scrollt */
        box-shadow: 0 2px 12px rgba(38, 29, 18, 0.18);
    }

    .site-nav a {
        display: inline-block;
        padding: 1.05rem 1.6rem;
        font-family: var(--font-body);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(244, 236, 216, 0.75);
        text-decoration: none;
        position: relative;
        transition: color 0.22s ease;
    }

    /* Terra-Unterstrich als Hover-Indikator */
    .site-nav a::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 1.6rem;
        right: 1.6rem;
        height: 2px;
        background-color: var(--color-terra);
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.22s ease;
    }

    .site-nav a:hover {
        color: var(--color-sand-light);
    }

    .site-nav a:hover::after {
        transform: scaleX(1);
    }

    /* ── Responsive ───────────────────────────────────────────────────────── */

    @media (max-width: 640px) {
        .hero-title {
            line-height: 1.4;
        }

        .site-nav {
            flex-wrap: wrap;
        }

        .site-nav a {
            padding: 0.8rem 1rem;
            font-size: 0.75rem;
        }

        .site-nav a::after {
            left: 1rem;
            right: 1rem;
        }
    }
</style>
