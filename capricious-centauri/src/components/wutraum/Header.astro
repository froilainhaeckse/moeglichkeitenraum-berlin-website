---
// Header.astro — Hero-Banner + Anker-Navigation
---


  <!-- ══════════════════════════════════════════════════════
       HEADER: Hero + Navigation (terra-Farbidentität)
  ══════════════════════════════════════════════════════ -->

<header class="site-header">

  <!-- ── Hero-Bild-Bereich ──────────────────────────── -->
  <div class="hero" role="img" aria-label="Frauen bei der Wutarbeit">

    <!-- Hintergrundbild: Ken-Burns-Bewegung + leichte Unschärfe -->
    <div class="hero-bg" aria-hidden="true"></div>

    <!-- Dunkles Gradient-Overlay für Textlesbarkeit -->
    <div class="hero-overlay" aria-hidden="true"></div>

    <!-- Wutraum-Button oben rechts -->
    <a href="/" class="moeglichkeitenraum-link" aria-label="Zum Möglichkeitenraum">
      Hier geht es zum Möglichkeitenraum ➔
    </a>

    <!-- Zitat -->
    <div class="hero-content">
      <p class="hero-kicker">Möglichkeitenraum Berlin</p>
      <h1 class="hero-title">
          Deine Wut ist kein Fehler.<br>
          Sie ist dein Feuer.
      </h1>
    </div>

  </div>

  <!-- ── Anker-Navigation (sticky nach dem Hero) ────── -->
  <nav class="site-nav" aria-label="Seitennavigation">
    <a href="/" class="wt-nav-back">← Möglichkeitenraum</a>
      <span class="wt-nav-divider" aria-hidden="true"></span>
      <a href="#wutraum-was">Was ist der Wutraum</a>
      <a href="#wutraum-fuer-wen">Für wen</a>
      <a href="#wutraum-angebote">Angebote</a>
      <a href="#wutraum-kontakt">Kontakt</a>
  </nav>

</header>

<style>
  /* ── Wrapper ──────────────────────────────────────────────────────────── */

  .site-header {
    display: flex;
    flex-direction: column;
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */

  .hero {
    position: relative;
    width: 100%;
    height: 100svh;       /* bildschirmfüllend, iOS-Safari-safe */
    min-height: 520px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /*
   * Hintergrundbild auf einem eigenen Layer.
   * inset: -5% gibt Spielraum für die Zoom-Animation,
   * damit am Rand kein weißer Streifen entsteht.
   */
  .hero-bg {
    position: absolute;
    inset: -5%;
    background-image: url('/images/hero_wutraum.png');
    background-size: cover;
    background-position: center top;  /* oben verankern, Logo unten abschneiden */
    will-change: transform, filter;
    animation: introZoom 18s ease-out forwards;

  }

@keyframes introZoom {
  from {
    transform: scale(1);
  }

  to {
    transform: scale(1.07);
  }
}

.hero-overlay::before {
  content: "";
  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 50% 18%,
      rgba(255,240,200,.22),
      transparent 45%
    );

  mix-blend-mode: screen;
}

.hero-overlay {
  position: absolute;
  inset: 0;

  background:

    radial-gradient(
      ellipse at center,
      rgba(0,0,0,0) 20%,
      rgba(0,0,0,.12) 65%,
      rgba(0,0,0,.45) 100%
    ),

linear-gradient(
  to bottom,
  rgba(38,29,18,0) 50%,
  rgba(38,29,18,.75) 82%,
  rgba(38,29,18,1) 100%
),

    linear-gradient(
      150deg,
      rgba(61,42,24,.12) 0%,
      rgba(38,29,18,.38) 70%,
      rgba(38,29,18,.55) 100%
    );
}

.hero-overlay::after {
  content: "";
  position: absolute;
  inset: 0;

  background:

    radial-gradient(
      circle at 50% 48%,
      rgba(255,220,140,.18),
      rgba(255,220,140,.05) 20%,
      transparent 45%
    );

  mix-blend-mode: screen;
}

  /* ── Wutraum-Link (oben rechts, über dem Overlay) ────────────────────── */

  .moeglichkeitenraum-link {
    position: absolute;
    top: 2rem;
    right: 2rem;
    z-index: 20;
    padding: 0.6rem 1.25rem;
    background-color: rgba(196, 77, 42, 0.88);
    color: #FAF6EE;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 3px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(250, 246, 238, 0.18);
    transition:
      background-color 0.22s ease,
      transform 0.18s ease;
  }

  .moeglichkeitenraum-link:hover {
    background-color: var(--color-terra);
    color: #FAF6EE;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .moeglichkeitenraum-link {
      top: 1rem;
      right: 1rem;
      font-size: 0.72rem;
      padding: 0.5rem 0.9rem;
    }
  }

  /* ── Zitat ────────────────────────────────────────────────────────────── */

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 2rem;
    max-width: 860px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-kicker {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(250, 246, 238, 0.65);
    margin: 0;
    max-width: none;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4.2vw, 3.1rem);
    font-weight: 700;
    line-height: 1.32;
    color: #FAF6EE;
    text-shadow:
      0 2px 8px  rgba(38, 29, 18, 0.45),
      0 8px 32px rgba(38, 29, 18, 0.30);
    margin: 0;
  }

  /* ── Anker-Navigation ─────────────────────────────────────────────────── */

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    background-color: var(--color-pine);
    /* dünner Schatten markiert die Nav, wenn Content darunter scrollt */
    box-shadow: 0 2px 12px rgba(38, 29, 18, 0.18);
  }

  .site-nav a {
    display: inline-block;
    padding: 1.05rem 1.6rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(244, 236, 216, 0.75);
    text-decoration: none;
    position: relative;
    transition: color 0.22s ease;
  }

  /* Terra-Unterstrich als Hover-Indikator */
  .site-nav a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 1.6rem;
    right: 1.6rem;
    height: 2px;
    background-color: var(--color-terra);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.22s ease;
  }

  .site-nav a:hover {
    color: var(--color-sand-light);
  }

  .site-nav a:hover::after {
    transform: scaleX(1);
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */

  @media (max-width: 640px) {
    .hero-title {
      line-height: 1.4;
    }

    .site-nav {
      flex-wrap: wrap;
    }

    .site-nav a {
      padding: 0.8rem 1rem;
      font-size: 0.75rem;
    }

    .site-nav a::after {
      left: 1rem;
      right: 1rem;
    }
  }
</style>
